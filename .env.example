# StreamFlow Configuration
DATABASE_URL="file:./prisma/dev.db"

# ── Twitch OAuth ──
# 1. Go to https://dev.twitch.tv/console/apps
# 2. Create a new application
# 3. Set OAuth Redirect URL to: http://localhost:3000/api/auth/callback
# 4. Copy Client ID and Client Secret below
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── YouTube (Google) OAuth ──
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:3000/api/auth/callback
# 4. Enable YouTube Data API v3
# 5. Copy Client ID and Client Secret below
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# �w�w Chat Worker �w�w
# ���N�üƪ��_�A�Ω�O�@ chat worker �� API ���q�T
CHAT_WORKER_KEY=dev-key

# BaseScan API Key (用於自動檢查 ZXC/YJC 轉帳)
# BASESCAN_API_KEY=你的_API_Key

# ── ZIXI OAuth ──
# 到 ZIXI Casino 後台取得以下資訊
# ZIXI_CLIENT_ID 和 ZIXI_CLIENT_SECRET 需由 ZIXI Casino 管理員建立
ZIXI_CLIENT_ID=livestream-dashboard
ZIXI_CLIENT_SECRET=
ZIXI_OAUTH_URL=https://zixi-casino.vercel.app

# ZIXI Admin Session (後備方案，用於 admin-transfer 等需要管理員權限的操作)
# 在 ZIXI Casino 以管理員登入後取得 sessionId 填入
ZIXI_ADMIN_SESSION=

# --- Groq transcription (src/lib/captions-groq.ts) --------------------
# Two providers are tried in order; the first configured one wins and the other
# stays as a fallback.

# 1) direct — fastest path, one HTTPS hop. Single key, so no rotation.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) router — slower (extra serverless hop) but rotates ~30 keys with cooldown
#    and credit accounting, so a long stream cannot get rate-limited off air.
GROQ_ROUTER_URL=https://vercel-router-khaki.vercel.app
GROQ_ROUTER_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# true = direct first then router. false = always via the router.
GROQ_DIRECT_FIRST=true
